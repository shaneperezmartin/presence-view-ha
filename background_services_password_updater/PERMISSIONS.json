{
  "helper_slug": "background_services_password_updater",
  "helper_version": "0.1.1",
  "target_config_slug": "dji_audio_archive",
  "target_installed_slug": "local_dji_audio_archive",
  "permission_requiring_action_time_confirmation": {
    "map": [
      {
        "type": "local_apps",
        "read_only": false
      }
    ],
    "scope_warning": "Mount exposes the whole local-apps source folder; code uses fixed verified target and private source recovery only"
  },
  "explicitly_disabled": {
    "homeassistant_api": false,
    "hassio_api": false,
    "host_network": false,
    "audio": false
  },
  "not_requested": [
    "privileged",
    "full_access",
    "target app data/config mount",
    "archive/model mount",
    "published ports",
    "network settings changes",
    "credential creation"
  ],
  "operations_requiring_separate_authorization": [
    "generic source publication if requested",
    "helper installation/security grant/execution/removal",
    "BOTH controls pause/drain/restore",
    "original app Update/restart and password boundary",
    "network/HTTPS configuration changes if needed",
    "rollback and loss of app password boundary"
  ],
  "runtime_defaults": {
    "mode": "inspect",
    "expected_fingerprint": "",
    "maintenance_confirmed": false,
    "rollback_security_loss_confirmed": false,
    "preserve_extra_files": [],
    "diagnostic_offset": 0,
    "diagnostic_snapshot": "",
    "private_baseline_config_sha256": ""
  },
  "private_pin_scope": "Independently recorded historical config hash, entered privately; authenticates only the reviewed two-field transform, never arbitrary source"
}
