<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Unlock Background Services</title><style>body{font:18px system-ui;max-width:32rem;margin:10vh auto;padding:1rem;background:#101820;color:#eef}input,button{font:inherit;padding:.7rem;margin:.5rem 0;width:100%;box-sizing:border-box}#message{min-height:3em}</style><h1>Background Services</h1><p>Enter your separate app password. Your Home Assistant login does not unlock this app.</p><form id="unlock"><label for="password">App password</label><input id="password" type="password" autocomplete="current-password" minlength="12" maxlength="256" required><button id="submit">Unlock</button></form><p id="message" role="status"></p><p>First time? <a href="setup">Set up on this phone</a> using your Home Assistant administrator account. Do not send passwords or setup codes in chat.</p><script>
const form=document.querySelector('#unlock'),password=document.querySelector('#password'),button=document.querySelector('#submit'),message=document.querySelector('#message');
form.addEventListener('submit',async e=>{e.preventDefault();button.disabled=true;message.textContent='Unlocking…';try{const r=await fetch('auth/login',{method:'POST',headers:{'Content-Type':'application/json','X-Archive-Control':'1'},body:JSON.stringify({password:password.value}),cache:'no-store'});password.value='';if(r.ok){location.replace('./');return}message.textContent=r.status===429?'Too many attempts. Wait five minutes and try again.':r.status===503?'App password has not been enrolled.':'Unable to unlock. Check the password and secure connection.'}catch(e){password.value='';message.textContent='Unable to connect. Try again.'}finally{button.disabled=false}});
</script></html>
