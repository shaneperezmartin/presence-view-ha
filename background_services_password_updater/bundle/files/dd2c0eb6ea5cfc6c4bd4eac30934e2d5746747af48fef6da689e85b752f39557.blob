FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PULSE_SERVER=unix:/run/audio/pulse.sock
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg pulseaudio-utils ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir torch==2.9.1+cpu torchaudio==2.9.1+cpu torchcodec==0.8.1 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements.txt && pip check
COPY enrollment.py setup.html test_enrollment.py app_auth.py password_admin.py login.html test_app_auth.py archive.py server.py index.html test_archive.py model_setup.py model_worker.py model-setup.html test_model_setup.py diarization.py diarization_worker.py test_diarization.py presentation.py test_presentation.py transcript_export.py test_transcript_export.py transcript_api.py transcript_client.py test_transcript_api.py probe_transcript_api.py file_browser.py test_file_browser.py batch_export.py test_batch_export.py ./
RUN python -m unittest -v test_archive test_model_setup test_diarization test_presentation test_transcript_export test_transcript_api test_file_browser test_batch_export test_app_auth test_enrollment
RUN PYANNOTE_METRICS_ENABLED=0 OTEL_SDK_DISABLED=true HF_HUB_OFFLINE=1 python -c "from pyannote.audio import Pipeline; import torch; assert torch.version.cuda is None"
CMD ["python", "/app/server.py"]
